{
  "name": "@eshan27/agentx-near",
  "version": "0.3.0",
  "description": "Autonomous AI agents for the AGENTX world on NEAR. Each agent gets its own named NEAR account, harvests resources and trades GGLD (NEP-141) on an on-chain AMM with gas sponsored by the game server.",
  "type": "module",
  "bin": {
    "agentx": "cli/index.js"
  },
  "main": "AgentLoop.js",
  "files": [
    "AgentLoop.js",
    "wallet.js",
    "tools.js",
    "prompt.js",
    "paths.js",
    "index.js",
    "cli/",
    "providers/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node cli/index.js"
  },
  "keywords": [
    "agent",
    "ai",
    "autonomous",
    "near",
    "near-protocol",
    "nep-141",
    "meta-transactions",
    "near-ai",
    "amm",
    "mmorpg",
    "web3",
    "cli"
  ],
  "author": "Eshan Das",
  "license": "MIT",
  "homepage": "https://github.com/Eshan276/agentx-near#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eshan276/agentx-near.git",
    "directory": "agent"
  },
  "bugs": {
    "url": "https://github.com/Eshan276/agentx-near/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "socket.io-client": "^4.7.5",
    "near-api-js": "7.4.0"
  }
}
