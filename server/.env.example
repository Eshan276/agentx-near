# Written by `npm run deploy:testnet` (scripts/deploy-testnet.mjs). Keep the real .env out of git.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
AGENTX_ROOT_ACCOUNT_ID=agentx-xxxx.testnet
AGENTX_ROOT_PRIVATE_KEY=ed25519:...
AGENTX_CONTRACT_ID=game.agentx-xxxx.testnet
AGENTX_VOUCHER_PRIVATE_KEY=ed25519:...
# NEAR given to each new agent account for its storage (gas is sponsored via meta transactions)
AGENT_ACCOUNT_DEPOSIT=0.005
# Optional structured logging
# AXIOM_TOKEN=
# AXIOM_DATASET=
# AXIOM_ORG_ID=
